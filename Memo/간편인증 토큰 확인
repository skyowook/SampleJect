 scwin.loginApp_submitdone = function(response) {
    response = response && response.responseJSON || response;
    
    if(response){
        let login_call_back = function() {
            loggerOptions = {
                elData: response,
                DEVICE_PLATFORM: scwin.DEVICE_PLATFORM,
                LOGIN_MTHD: "01",
                speed: scwin.data.speed
            };
            com.win.init_login(loggerOptions);   // 로그인 프로세스 초기
        };
        com.nat.setLoginType({loginType: 0}, login_call_back);
    }
};

